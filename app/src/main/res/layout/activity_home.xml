<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_color">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food Donation Hub"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnDonor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DONOR"
        android:textSize="18sp"
        android:backgroundTint="@color/donor_color"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_donor"
        android:drawablePadding="16dp"
        android:padding="20dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnReceiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RECEIVER"
        android:textSize="18sp"
        android:backgroundTint="@color/receiver_color"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_receiver"
        android:drawablePadding="16dp"
        android:padding="20dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnHowToUse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOW TO USE"
        android:textSize="18sp"
        android:backgroundTint="@color/guide_color"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_guide"
        android:drawablePadding="16dp"
        android:padding="20dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnContactUs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONTACT US"
        android:textSize="18sp"
        android:backgroundTint="@color/contact_color"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_contact"
        android:drawablePadding="16dp"
        android:padding="20dp" />

</LinearLayout>